# easy-kiosk 构建变量契约示例；当前未接入构建或运行时。
# 未来设置 Repository Variables/Secrets 或导出为构建进程环境变量。
# 占位值不能用于正式构建；真实 .env 不提交。
KIOSK_START_URL=https://replace-me.invalid/kiosk
# 必填 4～6 位数字；GitHub Actions 中使用 Secret，不写真实 PIN 到仓库。
KIOSK_ADMIN_PIN=REPLACE_WITH_PIN
KIOSK_AUTO_START=true
KIOSK_LOCK_MODE=true
KIOSK_KEEP_SCREEN_ON=true
KIOSK_ORIENTATION=portrait
KIOSK_AUTO_RELOAD=true
KIOSK_CONFIG_REVISION=1
ANDROID_VERSION_NAME=0.1.0-kiosk.1
ANDROID_VERSION_CODE=1
ANDROID_ABIS=arm64-v8a,armeabi-v7a,x86_64
# 签名 Secret 不在此文件填写，参见 docs/github-actions.md。
